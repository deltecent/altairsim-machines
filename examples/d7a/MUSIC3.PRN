	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ; MUSIC3.ASM
                                ;
                                ; This is MUSIC3.z80 by Dave Roberts (MUSIC3 20240817.zip), modified to assemble with
                                ; Microsoft M80 under CP/M. Build it with MUSIC3.SUB (M80, then L80 to MUSIC3.HEX).
                                ;
                                ; The code, the tables and the comments are the original. These things are changed:
                                ;   - Added .Z80 and ASEG at the start. Removed the ASM80 ".engine" directive.
                                ;   - ".if", ".else", ".endif", ".macro NAME", ".endm" and ".org" are in M80 form.
                                ;   - Hex constants 0x20 and $F0 are in the form 20H and 0F0H.
                                ;   - msb(X) is HIGH X, and ".align 256" is an ORG to the next 256-byte page.
                                ;   - The EQUs that use RAM are moved to the end, because M80 does not accept a
                                ;     forward reference in an EQU.
                                ;   - DEBUG is 0, for a CP/M .COM at 0100H that plays through the DAC.
                                ;     (Set it to 1 for the original debug build at 0000H.)
                                ;
                                	.Z80
  0000'                         	ASEG
                                
                                ; Modification history.
                                ; =====================
                                ;
                                ; Version : 
                                ;    Date : 
                                ;  Author : 
                                ;  Change : 
                                ;
                                ; Version : 0.30
                                ;    Date : 30th May 2024
                                ;  Author : Dave Roberts
                                ;  Change : Dang, I lost the last version of my code!
                                ;           Added the song STAR SPANGLED BANNER from the Byte Magazine.
                                ;           Delete the superflous "XOR A".
                                ;           Change the "ADD A,(HL)" to "LD A,(HL)" for the first voice.
                                ;           Update the frequency table for a 248T - 4T = 244T play loop.
                                ;         : Changed all JR to JP. Update T comments. Need to recalculate data tables...
                                ;         : Included code to configure for CP/M (ORG 100) and for the Cromemco D+7A.
                                ;
                                ; Version : 0.20
                                ;    Date : 5th January 2024
                                ;  Author : Dave Roberts
                                ;  Change : It seems to work...
                                ;
                                ; Version : 0.10
                                ;    Date : 4th January 2024
                                ;  Author : Dave Roberts
                                ;  Change : TEMPO and DURATION ito IYH and IYL using the documented
                                ;           undocumented Z80 instructions. I have also added a 
                                ;           compatability mode (which is obviously slower).
                                ;         : Added symbols TEST, DEBUG and USEUNDOC.
                                ;         : Start to convert to 16-bit Voice registers.
                                ;         : Remove TEST. I broke the assembler!
                                ;
                                ; Functionsal description.
                                ; ========================
                                ;
                                ; TODO: @@@
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                                
                                ; Definitions
                                ; ===========
                                ;
  0001                          USEUNDOC    EQU 1
  00FD                          PFIXIY      EQU 0FDH
                                
  0019                          DAC			EQU	19h			; Cromemco D+7A Analogue Output #1.
                                
  0000                          DEBUG       EQU 0
                                
                                
                                    
                                    IF DEBUG
                                LOADAT EQU 0000H
                                	ELSE
  0100                          LOADAT EQU 0100H
                                	ENDIF
                                
  0400                          K   EQU 1024
  0800                          K2  EQU (2 * K)
                                
                                
                                    IF DEBUG
                                TEMPO   EQU 06H ; For testing/debugging.
                                    ELSE
  0099                          TEMPO   EQU 99H ; For real. TODO: Check that the value is correct...
                                    ENDIF
                                    
                                ; Macros for the undocumented Z80 instructions I am going to use.
                                
                                LD_IYH_A	MACRO
                                    IF USEUNDOC
                                    db  PFIXIY
                                    LD  H,A
                                    ELSE
                                    LD  (IX+IYH),A
                                    ENDIF
                                    ENDM
                                    
                                LD_IYL_A	MACRO
                                    IF USEUNDOC
                                    db  PFIXIY
                                    LD  L,A
                                    ELSE
                                    LD  (IX+IYL),A
                                    ENDIF
                                    ENDM
                                    
                                DEC_IYH	MACRO
                                    IF USEUNDOC
                                    db  PFIXIY
                                    DEC H
                                    ELSE
                                    DEC (IX+IYH)
                                    ENDIF
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                                    ENDM
                                
                                DEC_IYL	MACRO
                                    IF USEUNDOC
                                    db  PFIXIY
                                    DEC L
                                    ELSE
                                    DEC (IX+IYL)
                                    ENDIF
                                    ENDM
                                    
                                    ; *******************
                                    ; ***             ***
                                    ; ***  ROM code.  ***
                                    ; ***             ***
                                    ; *******************
                                    
                                    ORG LOADAT
                                    
                                    ; ***********************
                                    ; ***                 ***
                                    ; ***  Main program.  ***
                                    ; ***                 ***
                                    ; ***********************
                                    
  0100                          START:
                                
                                    ; We use subroutine calls, so require a stack. Set it to the top of memory.
                                    ;
  0100    31 0E00                   LD      SP,TOS          ; 10T - Define a stack in RAM to use.
                                    
                                    ; Initialise RAM to zero on start-up to guarantee the state.
                                    ;
  0103    21 0600                   LD      HL,RAM+0        ; 10T - First byte of RAM.
  0106    11 0601                   LD      DE,RAM+1        ; 10T - Second byte of RAM.
  0109    01 0800                   LD      BC,K2           ; 10T - Number of bytes to clear. CHECK K2 or K2-1?
  010C    36 00                     LD      (HL),0          ; 10T - Seed the first byte with zero (0).
  010E    ED B0                     LDIR                    ;  8T - Go zap! (HL) to (DE), INC HL, INC DE, DEC BC and loop until BC zero.
                                                            ;       21T [BC <> 0] + 16T [BC == 0].
  0110    CD 0114                   CALL    MUSIC           ; 17T - Play the tune...
  0113    76                        HALT                    ;  4T - All finished.
                                    
                                    ; ***************************
                                    ; ***                     ***
                                    ; ***  MUSIC subroutine.  ***
                                    ; ***                     ***
                                    ; ***************************
                                    
  0114                          MUSIC:
                                
                                	IF DEBUG
                                	ld		a,'!'
                                	call	outa3
                                	ENDIF
                                	
  0114    21 0400                   LD      HL,SCORE        ; 10T - The start of the music score to play.
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                
                                    IF USEUNDOC
                                    ELSE
                                    ; IX is not required anymore - as the RAM is referred to by other means.
                                    ; Apart from the emulated undocumented Z80 instructions.
                                    ;
                                    LD      IX,WS           ; 14T - Working memory (IX should remain constant).
                                    ENDIF
                                    
                                    ; Initialise the Voice variable registers to 0.
                                    ;
  0117    11 0000                   LD      DE,0            ; 10T - Voice 1.
  011A    01 0000                   LD      BC,0            ; 10T - Voice 2.
  011D    D9                        EXX                     ;  4T - Switch register set to shadow.
  011E    11 0000                   LD      DE,0            ; 10T - Voice 3.
  0121    01 0000                   LD      BC,0            ; 10T - Voice 4.
  0124    D9                        EXX                     ;  4T - Switch register set back to normal again.
                                    
  0125                          MUSIC1:
                                
  0125    7E                        LD      A,(HL)          ;  7T - Pickup a byte from the score (duration).
  0126    B7                        OR      A               ;  4T - Check for a zero in the table.
  0127    C8                        RET     Z               ; 10T - Return from subroutine MUSIC if at the end of the SCORE.
                                    
                                    LD_IYH_A                ;  8T - Get duration byte into register IYH (for use by subroutine PLAY).
  0128    FD              +         db  PFIXIY
  0129    67              +         LD  H,A
                                
                                    ; The following code is 'unrolled' for speed (at the expense of size)...
                                    
  012A    C5                        PUSH    BC              ; 11T - Preserve Voice 2 onto the stack whilst we reuse it.
                                
  012B    06 03                     LD      B,HIGH FREQTBL  ;  7T - Frequency table start. Must be on a 256-byte boundary to work.
                                    
                                    ; ******************
                                    ; ***            ***
                                    ; ***  Voice 1.  ***
                                    ; ***            ***
                                    ; ******************
                                    
  012D    23                        INC     HL              ;  6T - Bump the pointer into the score table. First/next note.
  012E    4E                        LD      C,(HL)          ;  7T - Index into the next byte of the score table. A note ID.
  012F    0A                        LD      A,(BC)          ;  7T - Pick up the first byte of the note's frequency - fractional part.
  0130    32 0600                   LD      (V1FC),A        ; 13T - Store it away in the workspace - fractional part.
  0133    0C                        INC     C               ;  4T - Index to the next byte of the note's frequency - integer part.
  0134    0A                        LD      A,(BC)          ;  7T - Pick up the second byte of the note's frequency - integer part.
  0135    32 0601                   LD      (V1IC),A        ; 13T - Store it away in the workspace - integer part.
                                
                                    ; ******************
                                    ; ***            ***
                                    ; ***  Voice 2.  ***
                                    ; ***            ***
                                    ; ******************
                                    
  0138    23                        INC     HL              ;  6T - Bump the pointer into the score table. First/next note.
  0139    4E                        LD      C,(HL)          ;  7T - Index into the next byte of the score table. A note ID.
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  013A    0A                        LD      A,(BC)          ;  7T - Pick up the first byte of the note's frequency - fractional part.
  013B    32 0602                   LD      (V2FC),A        ; 13T - Store it away in the workspace - fractional part.
  013E    0C                        INC     C               ;  4T - Index to the next byte of the note's frequency - integer part.
  013F    0A                        LD      A,(BC)          ;  7T - Pick up the second byte of the note's frequency - integer part.
  0140    32 0603                   LD      (V2IC),A        ; 13T - Store it away in the workspace - integer part.
                                
                                    ; ******************
                                    ; ***            ***
                                    ; ***  Voice 3.  ***
                                    ; ***            ***
                                    ; ******************
                                    
  0143    23                        INC     HL              ;  6T - Bump the pointer into the score table. First/next note.
  0144    4E                        LD      C,(HL)          ;  7T - Index into the next byte of the score table. A note ID.
  0145    0A                        LD      A,(BC)          ;  7T - Pick up the first byte of the note's frequency - fractional part.
  0146    32 0604                   LD      (V3FC),A        ; 13T - Store it away in the workspace - fractional part.
  0149    0C                        INC     C               ;  4T - Index to the next byte of the note's frequency - integer part.
  014A    0A                        LD      A,(BC)          ;  7T - Pick up the second byte of the note's frequency - integer part.
  014B    32 0605                   LD      (V3IC),A        ; 13T - Store it away in the workspace - integer part.
                                
                                    ; ******************
                                    ; ***            ***
                                    ; ***  Voice 4.  ***
                                    ; ***            ***
                                    ; ******************
                                    
  014E    23                        INC     HL              ;  6T - Bump the pointer into the score table. First/next note.
  014F    4E                        LD      C,(HL)          ;  7T - Index into the next byte of the score table. A note ID.
  0150    0A                        LD      A,(BC)          ;  7T - Pick up the first byte of the note's frequency - fractional part.
  0151    32 0606                   LD      (V4FC),A        ; 13T - Store it away in the workspace - fractional part.
  0154    0C                        INC     C               ;  4T - Index to the next byte of the note's frequency - integer part.
  0155    0A                        LD      A,(BC)          ;  7T - Pick up the second byte of the note's frequency - integer part.
  0156    32 0607                   LD      (V4IC),A        ; 13T - Store it away in the workspace - integer part.
                                
  0159    23                        INC     HL              ;  6T - Bump the pointer into the score table again.
                                
  015A    C1                        POP     BC              ; 10T - Recover Voice 2 from the stack again.
                                    
                                    ; ***********************************************************************
                                    ; ***                                                                 ***
                                    ; ***  Go and play the specified note(s) for the specified duration.  ***
                                    ; ***                                                                 ***
                                    ; ***********************************************************************
                                    
                                    ; Note: PUSH and POP is faster than LD (nn),HL and LD HL,(nn).
                                    ; Note: 21T verses 32T.
                                    
  015B    E5                        PUSH    HL              ; 11T - Save the score pointer for use later.
  015C    CD 0163                   CALL    PLAY            ; 17T - Play the note(s).
  015F    E1                        POP     HL              ; 10T - Recover the score pointer.
                                
  0160    C3 0125                   JP      MUSIC1          ; 10T - Loop until done...
                                    
                                    ; **************************
                                    ; ***                    ***
                                    ; ***  PLAY subroutine.  ***
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


                                    ; ***                    ***
                                    ; **************************
                                    
                                    ; On entry, register IYH contains the music event duration.
                                
  0163                          PLAY:
                                
  0163                          PLAY1:
                                
  0163    3E 99                     LD      A,TEMPO         ;  7T - TEMPO is a constant.
                                    LD_IYL_A                ;  8T - stored in IYL.
  0165    FD              +         db  PFIXIY
  0166    6F              +         LD  L,A
                                    
                                    ; Symbol naming is as follows: V <voice number> <F or I> <C>
                                    ;
                                    ; Where:
                                    ; 
                                    ; F is the fractional part of the word.
                                    ; I is the integer    part of the word.
                                    ;
                                    ; C is the constant word.
                                    ;
                                    ; The numbers are addresses of bytes within the workspace.
                                    ;
                                    ; Note that the order is important. The fractional byte of the word
                                    ; must be at a lower address than the integer byte of the word. This
                                    ; is to ensure the correct byte order for loading HL via an
                                    ; instruction of the form LD HL,(V1FC). This will load the fractional
                                    ; byte into register L and the integer byte into register H.
                                    ;
                                    ; The Z80 registers are used as follows:
                                    ;
                                    ; DE  = Voice 1.
                                    ; BC  = Voice 2.
                                    ; DE' = Voice 3.
                                    ; BC' = Voice 4.
                                    ;
                                    ; These registers MUST be preserved at all times for use during the PLAY
                                    ; subroutine. They must NOT be corrupted by the MUSIC subroutine either.
                                    ;
                                    
                                
                                
                                
                                
  0167                          PLAY2:
                                
                                    ; ******************
                                    ; ***            ***
                                    ; ***  Voice 1.  ***
                                    ; ***            ***
                                    ; ******************
                                    
  0167    2A 0600                   LD      HL,(V1FC)   	; 16T - Voice 1 constant.
  016A    19                        ADD     HL,DE       	; 11T - Sum HL to Voice 1 variable.
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  016B    EB                        EX      DE,HL       	;  4T - Store resultant sum into Voice 1 variable.
                                    
                                    ; ******************
                                    ; ***            ***
                                    ; ***  Voice 2.  ***
                                    ; ***            ***
                                    ; ******************
                                    
  016C    2A 0602                   LD      HL,(V2FC)   	; 16T - Voice 2 constant.
  016F    09                        ADD     HL,BC       	; 11T - Sum HL to Voice 2 variable.
  0170    44                        LD      B,H         	;  4T - Store resultant sum into Voice 1 variable (high byte).
  0171    4D                        LD      C,L         	;  4T - Store resultant sum into Voice 1 variable (low  byte).
                                    
  0172    D9                        EXX                 	;  4T - Switch to shadow register set to process Voices 3 and 4.
                                    
                                    ; ******************
                                    ; ***            ***
                                    ; ***  Voice 3.  ***
                                    ; ***            ***
                                    ; ******************
                                    
  0173    2A 0604                   LD      HL,(V3FC)   	; 16T - Voice 3 constant.
  0176    19                        ADD     HL,DE       	; 11T - Sum HL' to Voice 3 variable.
  0177    EB                        EX      DE,HL       	;  4T - Store resultant sum into Voice 1 variable.
                                    
                                    ; ******************
                                    ; ***            ***
                                    ; ***  Voice 4.  ***
                                    ; ***            ***
                                    ; ******************
                                    
  0178    2A 0606                   LD      HL,(V4FC)   	; 16T - Voice 4 constant.
  017B    09                        ADD     HL,BC       	; 11T - Sum HL' to Voice 4 variable.
  017C    44                        LD      B,H         	;  4T - Store resultant sum into Voice 4 variable (high byte).
  017D    4D                        LD      C,L         	;  4T - Store resultant sum into Voice 4 variable (low  byte).
                                
                                    ; Derive the DAC output.
                                    
                                    ; Mote that we keep the shadow set of registers mapped in and process Voices 3 and 4
                                    ; first before switching to process Voices 1 and 2. This saves an EXX instruction (4T).
                                    
  017E    26 02                     LD      H,HIGH WAVETBL  ;  7T - This table should be page aligned.
                                
  0180    6A                        LD      L,D         	;  4T - Voice 3 Integer byte.
  0181    7E                        LD      A,(HL)      	;  7T - Index wave table for Voice 3 Integer byte.
                                    
  0182    68                        LD      L,B         	;  4T - Voice 4 Integer byte.
  0183    86                        ADD     A,(HL)      	;  7T - Index wave table for Voice 4 Integer byte.
                                    
  0184    D9                        EXX                 	;  4T - Switch back to the normal register set to process Voices 1 and 2.
                                    
  0185    26 02                     LD      H,HIGH WAVETBL  ;  7T - This table should be page aligned.
                                
  0187    6A                        LD      L,D         	;  4T - Voice 1 Integer byte.
  0188    86                        ADD     A,(HL)      	;  7T - Index wave table for Voice 1 Integer byte.
                                    
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  0189    68                        LD      L,B         	;  4T - Voice 2 Integer byte.
  018A    86                        ADD     A,(HL)      	;  7T - Index wave table for Voice 2 Integer byte.
                                
  018B    D6 80                     SUB		80h				; 7T - Convert from UNIPOLAR to BIPOLAR for Cromemco D+7A.
                                    
                                    IF DEBUG
                                    CALL    OUTAHEX     	; For debugging.
                                    ELSE
  018D    D3 19                     OUT     (DAC),A     	; 11T - Send the value in register A to the DAC.
                                    ENDIF
                                    
                                    DEC_IYL             	;  8T - Decrement the TEMPO.
  018F    FD              +         db  PFIXIY
  0190    2D              +         DEC L
  0191    C2 0167                   JP      NZ,PLAY2    	;  10T - Loop for more...
                                    
                                    DEC_IYH             	;  8T - Decrement the duration.
  0194    FD              +         db  PFIXIY
  0195    25              +         DEC H
  0196    C2 0163                   JP      NZ,PLAY1    	;  10T - Loop for more...
                                
                                    ; ***********************
                                    ; ***                 ***
                                    ; ***  All finished.  ***
                                    ; ***                 ***
                                    ; ***********************
                                    
  0199    C9                        RET                     ; 10T - Return from suproutine PLAY...
                                
                                    IF DEBUG
                                    
                                OUTAHEX:
                                
                                    push    af
                                    call    outa1
                                    pop     af
                                    call    outa2
                                    ld      a,'/'
                                    call    outa3
                                    ret
                                    
                                outa1:
                                    rra
                                    rra
                                    rra
                                    rra
                                outa2:
                                    or      0F0H
                                    daa
                                    add     a,0A0H
                                    adc     a,040H
                                outa3:
                                    out     (2),a
                                    ret
                                
                                    ENDIF
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


                                    
                                    ; This table needs to be on a page (256 byte) boundary.
                                    ; =====================================================
                                    ;
                                    ORG	($+255) AND 0FF00H
                                    ;
                                    ; Cosine integer wave table (4 voices @ 0-3F amplitude each, sum to FC).
                                    ; ======================================================================
                                    ;
  0200                          WAVETBL:
                                    ;  ;                        ;                        ;                        ;    
  0200    20 20 21 22               DB 20H, 20H, 21H, 22H,  23H, 23H, 24H, 25H,  26H, 26H, 27H, 28H,  29H, 29H, 2AH, 2BH ; 00
  0204    23 23 24 25           
  0208    26 26 27 28           
  020C    29 29 2A 2B           
  0210    2C 2C 2D 2E               DB 2CH, 2CH, 2DH, 2EH,  2EH, 2FH, 30H, 30H,  31H, 32H, 32H, 33H,  34H, 34H, 35H, 35H ; 10
  0214    2E 2F 30 30           
  0218    31 32 32 33           
  021C    34 34 35 35           
  0220    36 36 37 37               DB 36H, 36H, 37H, 37H,  38H, 38H, 39H, 39H,  3AH, 3AH, 3BH, 3BH,  3BH, 3CH, 3CH, 3CH ; 20
  0224    38 38 39 39           
  0228    3A 3A 3B 3B           
  022C    3B 3C 3C 3C           
  0230    3D 3D 3D 3D               DB 3DH, 3DH, 3DH, 3DH,  3EH, 3EH, 3EH, 3EH,  3EH, 3FH, 3FH, 3FH,  3FH, 3FH, 3FH, 3FH ; 30
  0234    3E 3E 3E 3E           
  0238    3E 3F 3F 3F           
  023C    3F 3F 3F 3F           
  0240    3F 3F 3F 3F               DB 3FH, 3FH, 3FH, 3FH,  3FH, 3FH, 3FH, 3EH,  3EH, 3EH, 3EH, 3EH,  3EH, 3DH, 3DH, 3DH ; 40
  0244    3F 3F 3F 3E           
  0248    3E 3E 3E 3E           
  024C    3E 3D 3D 3D           
  0250    3C 3C 3C 3B               DB 3CH, 3CH, 3CH, 3BH,  3BH, 3BH, 3AH, 3AH,  39H, 39H, 39H, 38H,  38H, 37H, 37H, 36H ; 50
  0254    3B 3B 3A 3A           
  0258    39 39 39 38           
  025C    38 37 37 36           
  0260    35 35 34 34               DB 35H, 35H, 34H, 34H,  33H, 33H, 32H, 31H,  31H, 30H, 2FH, 2FH,  2EH, 2DH, 2DH, 2CH ; 60
  0264    33 33 32 31           
  0268    31 30 2F 2F           
  026C    2E 2D 2D 2C           
  0270    2B 2A 2A 29               DB 2BH, 2AH, 2AH, 29H,  28H, 27H, 27H, 26H,  25H, 24H, 24H, 23H,  22H, 21H, 21H, 20H ; 70
  0274    28 27 27 26           
  0278    25 24 24 23           
  027C    22 21 21 20           
  0280    1F 1E 1D 1D               DB 1FH, 1EH, 1DH, 1DH,  1CH, 1BH, 1AH, 1AH,  19H, 18H, 17H, 17H,  16H, 15H, 14H, 14H ; 80
  0284    1C 1B 1A 1A           
  0288    19 18 17 17           
  028C    16 15 14 14           
  0290    13 12 11 11               DB 13H, 12H, 11H, 11H,  10H, 0FH, 0FH, 0EH,  0DH, 0DH, 0CH, 0CH,  0BH, 0AH, 0AH, 09H ; 90
  0294    10 0F 0F 0E           
  0298    0D 0D 0C 0C           
  029C    0B 0A 0A 09           
  02A0    09 08 08 07               DB 09H, 08H, 08H, 07H,  07H, 06H, 06H, 05H,  05H, 05H, 04H, 04H,  03H, 03H, 03H, 02H ; A0
  02A4    07 06 06 05           
  02A8    05 05 04 04           
  02AC    03 03 03 02           
  02B0    02 02 02 01               DB 02H, 02H, 02H, 01H,  01H, 01H, 01H, 01H,  00H, 00H, 00H, 00H,  00H, 00H, 00H, 00H ; B0
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  02B4    01 01 01 01           
  02B8    00 00 00 00           
  02BC    00 00 00 00           
  02C0    00 00 00 00               DB 00H, 00H, 00H, 00H,  00H, 00H, 00H, 01H,  01H, 01H, 01H, 01H,  02H, 02H, 02H, 02H ; C0
  02C4    00 00 00 01           
  02C8    01 01 01 01           
  02CC    02 02 02 02           
  02D0    03 03 03 04               DB 03H, 03H, 03H, 04H,  04H, 05H, 05H, 05H,  06H, 06H, 07H, 07H,  08H, 08H, 09H, 09H ; D0
  02D4    04 05 05 05           
  02D8    06 06 07 07           
  02DC    08 08 09 09           
  02E0    0A 0A 0B 0C               DB 0AH, 0AH, 0BH, 0CH,  0CH, 0DH, 0DH, 0EH,  0FH, 0FH, 10H, 11H,  11H, 12H, 13H, 14H ; E0
  02E4    0C 0D 0D 0E           
  02E8    0F 0F 10 11           
  02EC    11 12 13 14           
  02F0    14 15 16 17               DB 14H, 15H, 16H, 17H,  17H, 18H, 19H, 1AH,  1AH, 1BH, 1CH, 1DH,  1DH, 1EH, 1FH, 1FH ; F0
  02F4    17 18 19 1A           
  02F8    1A 1B 1C 1D           
  02FC    1D 1E 1F 1F           
                                
                                    ; This table needs to be on a page (256 byte) boundary.
                                    ; =====================================================
                                    ;
                                    ORG	($+255) AND 0FF00H
                                    ;
  0300                          FREQTBL:
                                    ;
                                    ; Frequency table for a 4 MHz Z80 CPU.
                                    ; ====================================
                                    ;
                                    ; The INCREMENT is calculated from the formula:
                                    ;
                                    ; INCREMENT = 256 * f / T
                                    ;
                                    ; Where:
                                    ;
                                    ; f is the desired note frequency (in Hertz).
                                    ; T is the sample rate (in Hertz).
                                    ;
                                    ; T is a function of the time taken to execute one iteration of
                                    ; the play loop. Calculate the time for one iteration (in seconds)
                                    ; and take the reciprocal (1/x) of the value to derive T.
                                    ;
                                    ; The floating point number obtained will be X.Y where X is the integer
                                    ; part and Y is the fractional part.
                                    ;
                                    ; The integer part (X) is used as the high byte directly whilst the fractional 
                                    ; part is converted into a byte value in the range 0 through 255.
                                    ;
                                    ; As an example (from the BYTE article):
                                    ;
                                    ; 8.772 kHz sample rate.
                                    ; Desired frequency = C2 = 65.405 Hz
                                    ; Given increment = 1.9089
                                    ; Given bytes = integer = 1, fractional = 233.
                                    ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                    ; 1.9089 = an integer part of 1.
                                    ; 0.9089 * 256 = 232.7 (rounded to 233). Although why 256 and not 255?
                                    ;
                                    ; Using the formual above for INCREMENT:
                                    ;
                                    ; INCREMENT = 256 * 65.405 / 8772 = 1.9089 (rounded).
                                    ; 
                                    ; Now, I need to ascertain the corresponding maths for the Z80 implementation...
                                    ;
                                    ; The following hexadecimal word values are taken from the handwriting on the
                                    ; 6502 frequency table listing.
                                    ;
                                    ; Ideally, I will generate the byte table from a spreadsheet containing the 
                                    ; note frequencies and the entered number of T states (at a clock frequency of 
                                    ; 4 MHz).
                                    ;
                                    ; This table is for the 'original' Z80 project.
                                    ;
                                    IF 0
                                    ;           ; ID  NOTE FREQUENCY
                                    DW  0000H  ;  0  SILENCE
                                    DW  0305H  ;  2  C2     65.405
                                    DW  0333H  ;  4  C2#    69.295
                                    DW  0364H  ;  6  D2     73.415
                                    DW  039BH  ;  8  D2#    77.783
                                    DW  03CEH  ; 10  E2     82.408
                                    DW  040BH  ; 12  F2     87.308
                                    DW  0446H  ; 14  F2#    92.498
                                    DW  04B7H  ; 16  G2     97.998
                                    DW  04CCH  ; 18  G2#   103.83
                                    DW  0515H  ; 20  A2    110.00
                                    DW  0562H  ; 22  A2#   116.54
                                    DW  0564H  ; 24  B2    123.47
                                    DW  060BH  ; 26  C3    130.81
                                    DW  0667H  ; 28  C3#   138.59
                                    DW  06C8H  ; 30  D3    146.83
                                    DW  0795H  ; 32  D3#   155.57
                                    DW  079DH  ; 34  E3    164.82
                                    DW  0811H  ; 36  F3    174.62
                                    DW  08CCH  ; 38  F3#   185.00
                                    DW  090EH  ; 40  G3    196.00
                                    DW  0998H  ; 42  G3#   207.65
                                    DW  0A2AH  ; 44  A3    220.00
                                    DW  0AC5H  ; 46  A3#   233.08
                                    DW  0B69H  ; 48  B3    246.94
                                    DW  0C16H  ; 50  C4    261.62
                                    DW  0CCFH  ; 52  C4#   277.18
                                    DW  0D91H  ; 54  D4    293.66
                                    DW  0E60H  ; 56  D4#   311.13
                                    DW  0F3BH  ; 58  E4    329.63
                                    DW  1023H  ; 60  F4    349.23
                                    DW  1118H  ; 62  F4#   369.99
                                    DW  121DH  ; 64  G4    391.99
                                    DW  1330H  ; 66  G4#   415.30
                                    DW  1455H  ; 68  A4    440.00
                                    DW  158AH  ; 70  A4#   466.16
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


                                    DW  16D2H  ; 72  B4    493.88
                                    DW  182DH  ; 74  C5    523.24
                                    DW  199EH  ; 76  C5#   554.36
                                    DW  1B23H  ; 78  D5    587.32
                                    DW  1CC1H  ; 80  D5#   622.26
                                    DW  1E77H  ; 82  E5    659.26
                                    DW  2046H  ; 84  F5    698.46
                                    DW  2231H  ; 86  F5#   739.98
                                    DW  243AH  ; 88  G5    783.98
                                    DW  2661H  ; 90  G5#   830.60
                                    DW  28AAH  ; 92  A5    880.00
                                    DW  2B15H  ; 94  A5#   932.32
                                    DW  2DA5H  ; 96  B5    987.76
                                    DW  305CH  ; 98  C6   1046.5
                                    ENDIF
                                   
